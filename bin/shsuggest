#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Mike\Shsuggest\Application;
use Mike\Shsuggest\ConfigLoader;
use Mike\Shsuggest\SuggestionSourceFactory;

$loader = new ConfigLoader();
$config = $loader->load();
$factory = new SuggestionSourceFactory($config);
$client = $factory->create();

$app = new Application($config, $client, $loader);
exit($app->run($argv));
